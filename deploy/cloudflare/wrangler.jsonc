{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ledger-fava",
	"main": "src/index.ts",
	"upload_source_maps": true,
	"compatibility_date": "2026-10-13",
	"observability": { "enabled": true },
	"containers": [
		{
			"class_name": "Fava",
			"image": "../container/Dockerfile",
			"image_build_context": "../..",
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "FAVA", "class_name": "Fava" }]
	},
	"exports": {
		"Fava": { "type": "durable-object", "storage": "sqlite" }
	},
	// Set LEDGER_REPO to your ledger repository before deploying.  LEDGER_TOOLS_COMMIT
	// is filled in at deploy time (see README.md).
	"vars": { "LEDGER_REPO": "<owner>/<repo>", "LEDGER_BRANCH": "master", "LEDGER_TOOLS_COMMIT": "" },
	"secrets": { "required": ["GITHUB_TOKEN"] }
}
